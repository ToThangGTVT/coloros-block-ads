<?xml version="1.0" encoding="utf-8"?>
<!-- COUI 1.1.0 OverlayBottomSheet: 24dp drag strip, centered 18sp title, 24dp side margin. -->
<com.utc.color.blockads.core.designsystem.CouiSheetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/bg_coui_panel"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">
        <FrameLayout
            android:id="@+id/drag_handle"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:paddingTop="4dp">
            <View
                android:id="@+id/drag_handle_press"
                android:layout_width="70dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_coui_panel_handle_press"
                android:importantForAccessibility="no" />
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_coui_panel_handle"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />
        <FrameLayout
            android:id="@+id/sheet_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</com.utc.color.blockads.core.designsystem.CouiSheetLayout>
